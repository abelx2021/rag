#!/usr/bin/env bash
# PORTABLE COPY - generated by services/generate_templates.py from the live script.
# Runs on macOS and Linux: stat/hash/converter/shell are detected at startup.
# Placeholders (double-underscore names) are substituted by services/install.sh.
# ingest-watch.sh — watch $KNOWLEDGE/*/raw/** and ingest new/changed source files
# automatically via headless Claude Code. Intended to run as a LaunchAgent.
#
# Compatible with macOS bash 3.2 (no associative arrays).
#
# The nested ingest runs with a SCOPED allowlist (not bypassPermissions):
#   Read, Write, Edit, Bash(abbrain:*), Bash(textutil:*)
# — every other tool/command is denied.
#
#   start:  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ab.knowledge-ingest.plist
#   stop:   launchctl bootout  gui/$(id -u)/com.ab.knowledge-ingest
#   logs:   $KNOWLEDGE/.claude/ingest-watch.log
#   state:  $KNOWLEDGE/.claude/ingested.tsv  (path <TAB> sha256 <TAB> mtime <TAB> size)

set -u

KNOWLEDGE="${KNOWLEDGE_ROOT:-__KNOWLEDGE_ROOT__}"
CLAUDE_DIR="$KNOWLEDGE/.claude"
STATE="$CLAUDE_DIR/ingested.tsv"          # path <TAB> sha256 <TAB> mtime <TAB> size
SEEN="$CLAUDE_DIR/seen.tsv"               # path <TAB> mtime:size  (debounce)
RETRIES="$CLAUDE_DIR/ingest-retries.tsv"  # path <TAB> count
LOG="$CLAUDE_DIR/ingest-watch.log"
LOCK="$CLAUDE_DIR/.ingest-lock"

# ---------------------------------------------------------------- platform
# Detected once. BSD (macOS) and GNU (Linux) differ on stat and hashing; the docx
# converter and the login shell differ too. Nothing below this point is platform-bound.

if stat -f %m "$0" >/dev/null 2>&1; then
  STAT_MTIME="stat -f %m"
  STAT_SIZE="stat -f %z"
else
  STAT_MTIME="stat -c %Y"
  STAT_SIZE="stat -c %s"
fi

if command -v sha256sum >/dev/null 2>&1; then
  SHA_TOOL="sha256sum"
elif command -v shasum >/dev/null 2>&1; then
  SHA_TOOL="shasum -a 256"
else
  SHA_TOOL=""
fi

# Text extraction for docx/doc/rtf. macOS has textutil; Linux usually libreoffice.
if command -v textutil >/dev/null 2>&1; then
  CONVERT_CMD='textutil -convert txt "$SRC" -output "$DST"'
elif command -v soffice >/dev/null 2>&1; then
  CONVERT_CMD='soffice --headless --convert-to txt:Text --outdir "$(dirname "$DST")" "$SRC" && mv "$(dirname "$DST")/$(basename "${SRC%.*}").txt" "$DST"'
elif command -v libreoffice >/dev/null 2>&1; then
  CONVERT_CMD='libreoffice --headless --convert-to txt:Text --outdir "$(dirname "$DST")" "$SRC" && mv "$(dirname "$DST")/$(basename "${SRC%.*}").txt" "$DST"'
elif command -v pandoc >/dev/null 2>&1; then
  CONVERT_CMD='pandoc -t plain "$SRC" -o "$DST"'
else
  CONVERT_CMD=''
fi

# What the ingest prompt is told to run for a binary source. Never leave the agent
# with an empty command to "run" - tell it to stop instead.
if [ -n "$CONVERT_CMD" ]; then
  CONVERT_HINT="   SRC="\$f" DST="$KNOWLEDGE/.claude/.ingest-convert.txt"
   $CONVERT_CMD"
else
  CONVERT_HINT="   (no docx/doc/rtf converter on this machine - if the source is binary, report it and stop.)"
fi

# The agent CLI is reached through a login shell so it inherits the user's auth.
# Prefer bash/zsh over $SHELL: those are the shells whose -lic semantics and rc files
# the agent CLI expects (a dash or fish user would get neither).
if [ -x /bin/zsh ]; then
  AGENT_SHELL=/bin/zsh
elif [ -x /bin/bash ]; then
  AGENT_SHELL=/bin/bash
elif [ -n "${SHELL:-}" ] && [ -x "$SHELL" ]; then
  AGENT_SHELL="$SHELL"
else
  AGENT_SHELL=/bin/sh
fi

# Fail loudly rather than silently skipping every source: without a hashing tool the
# change check can never match and nothing would ever be ingested.
if [ -z "$SHA_TOOL" ]; then
  printf '[%s] no sha256 tool found (need sha256sum or shasum) - cannot track sources; exiting
'     "$(date '+%Y-%m-%d %H:%M:%S')" >> "$LOG"
  exit 1
fi
# ---- end platform ----

# launchd passes a minimal PATH; restore what the daemon needs.
# version, and include the usual Linux and Homebrew locations.
NODE_BIN="$(ls -d "$HOME"/.nvm/versions/node/*/bin 2>/dev/null | sort -V | tail -1)"
export PATH="$HOME/.local/bin:${NODE_BIN:-}:$HOME/.hermes/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/snap/bin"

# Which agent CLI to drive. `cla` is a zsh wrapper some machines define (e.g. a
# gateway account); a fresh machine uses plain `claude`. Override with
# INGEST_CLAUDE_CMD.
CLAUDE_CMD="${INGEST_CLAUDE_CMD:-__DEFAULT_CLAUDE_CMD__}"
export CLAUDE_CMD
if ! "$AGENT_SHELL" -lic "command -v $CLAUDE_CMD" >/dev/null 2>&1; then
  echo "[$(date)] agent CLI not found: $CLAUDE_CMD (set INGEST_CLAUDE_CMD)" >> "$LOG"
  exit 1
fi

POLL=3          # seconds between scans
STABLE=2        # consecutive polls a file must be unchanged before ingesting
MAX_ATTEMPTS=3  # per-file retry cap before giving up
TIMEOUT=900     # seconds before killing a hung ingest

mkdir -p "$CLAUDE_DIR"
touch "$STATE" "$SEEN" "$RETRIES" "$LOG"

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }

ingest_prompt() {
  local f="$1" vault="$2"
  cat <<PROMPT
Ingest a source into the LLM Wiki. Follow the ingest workflow in $KNOWLEDGE/CLAUDE.md.

Vault: $vault
Source file (absolute path): $f

Do all of this autonomously, with no user interaction:
1. Read the source fully. If it is .docx/.doc/.rtf, convert it first with exactly:
$CONVERT_HINT
   then Read "$KNOWLEDGE/.claude/.ingest-convert.txt". (.md/.txt/.pdf/images can be Read directly.)
2. Write a summary page in $KNOWLEDGE/$vault/wiki/ — kebab-case filename, YAML frontmatter
   (tags + created), a one-line summary at the top, and [[wikilinks]] to related pages.
3. Update $KNOWLEDGE/$vault/index.md — add entries under the correct category.
4. Create or update related concept/entity pages as warranted; add [[wikilinks]] both ways.
5. Append "## [YYYY-MM-DD] ingest | <Title>" to $KNOWLEDGE/$vault/log.md.
6. __INDEX_STEP__

Finally, reply with a few lines listing the pages you created or updated.
PROMPT
}

mark_ingested() {
  local f="$1" h="$2" m="$3" s="$4"
  awk -v p="$f" 'BEGIN{FS="\t"} $1!=p' "$STATE" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
  printf '%s\t%s\t%s\t%s\n' "$f" "$h" "$m" "$s" >> "$STATE"
}

clear_retries() {
  awk -v p="$1" 'BEGIN{FS="\t"} $1!=p' "$RETRIES" > "$RETRIES.tmp" && mv "$RETRIES.tmp" "$RETRIES"
}

bump_retries() {
  clear_retries "$1"
  printf '%s\t%s\n' "$1" "$2" >> "$RETRIES"
}

ingest() {
  local f="$1" vault="$2"

  local m s
  m="$($STAT_MTIME "$f" 2>/dev/null)"
  s="$($STAT_SIZE "$f" 2>/dev/null)"
  [ -n "$m" ] && [ -n "$s" ] || return

  local h
  h="$($SHA_TOOL "$f" 2>/dev/null | awk '{print $1}')"
  [ -n "$h" ] || return

  # already ingested at this exact content?
  awk -v p="$f" -v h="$h" 'BEGIN{FS="\t"} $1==p && $2==h {ok=1} END{exit !ok}' "$STATE" && return

  # retry cap
  local n
  n="$(awk -v p="$f" 'BEGIN{FS="\t"} $1==p {print $2; exit}' "$RETRIES")"
  n="${n:-0}"
  if [ "$n" -ge "$MAX_ATTEMPTS" ]; then
    log "giving up on: $f (after $MAX_ATTEMPTS attempts); NOT marked ingested — reset ingest-retries.tsv to retry"
    return
  fi

  if ! mkdir "$LOCK" 2>/dev/null; then
    log "lock busy; will retry: $f"
    return
  fi

  log "ingesting: $f (vault=$vault)"
  local prompt rc
  prompt="$(ingest_prompt "$f" "$vault")"
  export QMD_INGEST_PROMPT="$prompt"

  # Reuse the user's `cla` function from ~/.zshrc for auth (DeepSeek env) — no key copied here.
  ( cd "$KNOWLEDGE" && "$AGENT_SHELL" -lic 'for rc in ~/.zshrc ~/.bashrc; do [ -f "$rc" ] && . "$rc"; done; "$CLAUDE_CMD" -p "$QMD_INGEST_PROMPT" --allowedTools "Read,Write,Edit,Bash(abbrain:*),Bash(textutil:*),Bash(soffice:*),Bash(libreoffice:*),Bash(pandoc:*)"' ) >> "$LOG" 2>&1 &
  local cpid=$!
  local waited=0
  while kill -0 "$cpid" 2>/dev/null && [ "$waited" -lt "$TIMEOUT" ]; do
    sleep 5; waited=$((waited+5))
  done
  if kill -0 "$cpid" 2>/dev/null; then
    kill "$cpid" 2>/dev/null; rc=124
    log "timed out after ${TIMEOUT}s: $f"
  else
    wait "$cpid"; rc=$?
  fi

  rmdir "$LOCK" 2>/dev/null

  if [ "$rc" -eq 0 ]; then
    mark_ingested "$f" "$h" "$m" "$s"
    clear_retries "$f"
    log "ok: $f"
  else
    bump_retries "$f" "$((n+1))"
    log "FAILED (rc=$rc): $f — attempt $((n+1))/$MAX_ATTEMPTS"
  fi
}

log "watcher started (pid $$)"

while true; do
  # prune state entries whose file no longer exists
  if [ -s "$STATE" ]; then
    : > "$STATE.tmp"
    while IFS=$'\t' read -r p h m s; do
      [ -z "$p" ] && continue
      [ -e "$p" ] && printf '%s\t%s\t%s\t%s\n' "$p" "$h" "$m" "$s" >> "$STATE.tmp"
    done < "$STATE"
    mv "$STATE.tmp" "$STATE"
  fi

  # fresh debounce file each poll
  : > "$SEEN.new"

  # scan for source files under any vault's raw/
  while IFS= read -r -d '' f; do
    rel="${f#$KNOWLEDGE/}"
    case "$rel" in */raw/*) : ;; *) continue ;; esac
    case "$rel" in _template/*) continue ;; esac

    base="$(basename "$f")"
    case "$base" in .*|*.gitkeep|*.DS_Store) continue ;; esac

    [[ "$f" =~ \.(md|txt|pdf|docx|doc|rtf|html|htm|csv|json|odt|webarchive)$ ]] || continue

    vault="${rel%%/*}"

    m="$($STAT_MTIME "$f" 2>/dev/null)"
    s="$($STAT_SIZE "$f" 2>/dev/null)"

    # unchanged & already ingested?
    awk -v p="$f" -v m="$m" -v s="$s" 'BEGIN{FS="\t"} $1==p && $3==m && $4==s {ok=1} END{exit !ok}' "$STATE" && continue

    # debounce: stable for STABLE consecutive polls (was in SEEN last poll with same mtime:size)?
    ms="$m:$s"
    if awk -v p="$f" -v ms="$ms" 'BEGIN{FS="\t"} $1==p && $2==ms {ok=1} END{exit !ok}' "$SEEN"; then
      ingest "$f" "$vault"
    else
      printf '%s\t%s\n' "$f" "$ms" >> "$SEEN.new"
    fi
  done < <(find "$KNOWLEDGE" -path '*/raw/*' -type f -print0 2>/dev/null)

  mv "$SEEN.new" "$SEEN"
  sleep "$POLL"
done
